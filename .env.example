# Copy to .env. SQLite path is relative to backend/prisma/.
DATABASE_URL="file:./dev.db"

# PORT=3000
# UPLOAD_DIR=./uploads

# --- CV tuning (all optional; defaults live in src/config.ts) ---
# CV_MIN_PX_PER_MM=30          below this a "pass" is downgraded to needs_review (plan §6)
# CV_REFUSE_PX_PER_MM=8        below this the capture is rejected outright
# CV_TOLERANCE_MM=0.05         edge tolerance band; features smaller than this are not judged
# CV_MORPH_KERNEL_SIZE=3       opening kernel applied to diff maps (must stay < smallest real defect)
# CV_MIN_DEFECT_AREA_PX=10     floor on defect blob area
# CV_BINARIZE_CHANNEL=gray     gray | red | green | value  (which channel separates copper from substrate)
